<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="add_transactions_constraints" author="Araev_KS">
        <addNotNullConstraint tableName="transactions" columnName="client_id"/>
        <addNotNullConstraint tableName="transactions" columnName="category_id"/>
        <addNotNullConstraint tableName="transactions" columnName="date"/>
        <addNotNullConstraint tableName="transactions" columnName="amount"/>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="client_id"
                constraintName="client_id"/>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="objects_id"
                referencedTableName="objects"
                referencedColumnNames="object_id"
                constraintName="objects_id"/>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="category_id"
                referencedTableName="transactionCategories"
                referencedColumnNames="category_id"
                constraintName="category_id"/>
    </changeSet>
</databaseChangeLog>